# NovaFlow / Brand Guardian - environment template
#
# Copy to a local `.env` (which .gitignore excludes) and fill in real values.
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit a populated .env, and
# never paste a real secret into this template.

# ---------------------------------------------------------------------------
# Security (backend) - REQUIRED
# ---------------------------------------------------------------------------

# "development" (default) or "production".
# In production the backend REFUSES TO START unless JWT_SECRET_KEY is set to a
# valid, non-placeholder value.
NOVAFLOW_ENV=development

# HMAC signing key for access tokens. Minimum 32 characters.
# Known placeholder values (including the one previously hardcoded in the
# source) are rejected outright.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave this UNSET in local development and the backend generates an ephemeral
# per-process key; sessions then stop working on restart, which is the signal
# to set a real one here.
JWT_SECRET_KEY=

# Optional. HS256 (default), HS384 or HS512.
JWT_ALGORITHM=HS256

# Optional. Session lifetime in minutes. Default 1440 (24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional. Exact frontend origins, comma-separated. "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Set to "true" to expose /docs and /openapi.json in production.
# Off by default so the route surface is not published.
EXPOSE_API_DOCS=false

# ---------------------------------------------------------------------------
# Rate limiting (credential endpoints)
# ---------------------------------------------------------------------------
#
# IMPORTANT: counters are held in process memory, so the effective limit is
# multiplied by the number of workers/instances you run. This is honest
# protection for a single-process deployment, NOT distributed protection.
# See docs/SECURITY_OPERATIONS.md before scaling out.

# Optional. "false" disables the limiter entirely. Leave enabled.
RATE_LIMIT_ENABLED=true

# Optional. Limits for POST /auth/login. Format: <count>/<period>, several
# rules separated by ";". The hourly ceiling stops a slow attacker from
# walking around the per-minute budget.
RATE_LIMIT_LOGIN=5/minute;20/hour

# Optional. Limits for POST /auth/signup.
RATE_LIMIT_SIGNUP=3/minute;10/hour

# Optional. Number of TRUSTED reverse proxies in front of the app.
# 0 (default) means X-Forwarded-For is IGNORED and the peer address is used.
# Only raise this if you actually run that many proxies: a client can put
# anything in X-Forwarded-For, and trusting it lets an attacker mint a fresh
# rate-limit bucket per request.
TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Optional. Server-side ceiling in bytes. Default 104857600 (100 MiB).
MAX_UPLOAD_BYTES=104857600

# Optional. Comma-separated, alphanumeric. Default mp4,mov,avi,webm,mkv.
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,webm,mkv

# ---------------------------------------------------------------------------
# Analysis pipeline (Phase 4)
# ---------------------------------------------------------------------------
#
# These bound both FFmpeg work and Bedrock spend: duration x fps determines how
# many model calls one upload costs.

# Optional. Longest clip accepted for analysis, in seconds. Default 60.
MAX_VIDEO_DURATION_SECONDS=60

# Optional. Frames sampled per second of video. Default 1.
# A violation visible for less than one sampling interval can be missed.
FRAME_SAMPLE_FPS=1

# Optional. Hard cap on extracted frames per video. Default 120.
# The backstop: a malformed container can report a short duration and still
# yield far more frames.
MAX_FRAMES_PER_VIDEO=120

# Optional. Wall-clock limit for one FFmpeg run, in seconds. Default 300.
FFMPEG_TIMEOUT_SECONDS=300

# Optional. Bounded retries per frame for RETRYABLE Bedrock errors
# (throttling, timeouts). Validation and authorization failures are never
# retried. Default 3.
BEDROCK_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Remediation (Phase 8)
# ---------------------------------------------------------------------------
#
# Two separate switches, because they gate two different things.

# Optional. The PROPOSAL AND REVIEW workflow: an owner can ask for a
# remediation proposal against a finding, read what it would change and why,
# and approve or reject it. Pure application logic over findings the analyzer
# already persisted - no provider call, no spend, and no change to any stored
# video. Default true. Setting it false makes every /remediations route answer
# 404, so a deployment that has turned the feature off does not advertise it.
REMEDIATION_ENABLED=true

# Optional. Which image-generation provider to use. Default "none".
#
# "none"         No generation. /remediations/{id}/execute answers 503 and
#                leaves the record approved, so the proposal stays executable
#                if a provider is configured later.
# "nova-canvas"  ACCEPTED but NOT IMPLEMENTED. Configuring it changes nothing
#                functional: the API reports generation as unavailable with a
#                reason naming what is missing. It exists as a value so a
#                typo is distinguishable from a deliberate request for a
#                capability that does not exist yet.
#
# Any other value is a ConfigurationError at startup.
#
# WHY NO PROVIDER SHIPS: the Nova Canvas request and response schema could not
# be verified from this project's pinned SDK (botocore types
# bedrock-runtime InvokeModel's body as an opaque blob), from existing code,
# or from documentation in the repository - and the project forbids guessing a
# provider wire format. See docs/REMEDIATION.md for exactly what an
# implementation and its operator must supply, including the IAM grant that
# infra/iam_policy_least_privilege.json deliberately still withholds.
REMEDIATION_IMAGE_PROVIDER=none

# Optional. Model confidence at or above which a finding may be remediated
# automatically. Default 0.8, which is the figure docs/planning.md has
# specified since Phase 1 - Phase 8 is the first code to read it.
#
# What it gates: a proposal records whether the finding met it, and EXECUTION
# of a proposal that did not is refused. It does NOT gate whether a proposal
# can be created or reviewed - a human should be able to look at a
# low-confidence finding, which is the point of review. A finding with NO
# reported confidence does not pass: absent is not the same as high.
REMEDIATION_MIN_CONFIDENCE=0.8

# Optional. Cap on remediation records per video. Default 200.
# A proposal is cheap, but an endpoint that is free to call should still have
# a bound.
MAX_REMEDIATIONS_PER_VIDEO=200

# ---------------------------------------------------------------------------
# Worker leases and crash recovery (Phase 4.1)
# ---------------------------------------------------------------------------
#
# Optional. How long a worker's claim on a job stays valid without a
# heartbeat, in seconds. Default 300.
#
# This must comfortably exceed the longest gap between heartbeats, or a live
# worker gets its job reclaimed while it is still processing. The pipeline
# heartbeats at every stage boundary and after each analysed frame, and one
# frame is bounded by BEDROCK_MAX_ATTEMPTS, so the default is generous.
# Lowering it makes recovery faster but risks reclaiming healthy slow jobs.
JOB_LEASE_SECONDS=300

# Optional. Sweep for jobs abandoned by a dead worker when the process starts.
# Default true.
#
# Set this to false on all but one instance if you run several behind a load
# balancer, so they do not all sweep at once. Note that the startup sweep is
# NOT continuous recovery: a job abandoned while the process stays up is not
# noticed until the next restart. For recurring recovery, schedule
# `python backend/recover_jobs.py --apply`; see docs/PIPELINE_OPERATIONS.md.
RECOVER_JOBS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Job execution: the durable worker (Phase 6)
# ---------------------------------------------------------------------------
#
# How an accepted analysis job gets executed.
#
#   worker  The API records the job as queued and returns. A separate process,
#           `python backend/worker.py`, claims and runs it. The API and the
#           worker restart independently and an accepted job survives either,
#           because the job record IS the queue. This is the default in
#           production and what a real deployment should use.
#
#   inline  The API also hands the job to an in-process BackgroundTasks
#           thread, which is how Phases 4 and 4.1 worked. Convenient for
#           single-process local development; NOT durable - killing the API
#           mid-job strands that job until a recovery sweep requeues it.
#
# Default: inline in development, worker in production. Set it explicitly.
#
# DEPLOYMENT ORDER: provision storage, set S3_BUCKET_NAME and MONGODB_URL,
# start the API, then start at least one worker. With JOB_EXECUTION_MODE=worker
# and no worker running, uploads and submissions still succeed and jobs simply
# accumulate in `queued` - GET /health/worker is how you see that.
JOB_EXECUTION_MODE=inline

# Optional. Seconds between queue polls when the worker finds nothing to do.
# One poll is a single indexed query. Default 5.
WORKER_POLL_INTERVAL_SECONDS=5

# Optional. Seconds between abandoned-job recovery sweeps inside the worker.
# This is what makes recovery continuous rather than startup-only. Set to 0 to
# disable it and rely on an external schedule of
# `python backend/recover_jobs.py --apply` instead. Default 60.
WORKER_RECOVERY_INTERVAL_SECONDS=60

# Optional. Seconds a worker waits for the running job to finish after
# SIGTERM/SIGINT before exiting anyway. On expiry the job's lease is left to
# lapse and a sweep requeues it; nothing is reported as completed. Default 30.
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Optional. Base delay before a job requeued after a RETRYABLE failure (a
# throttle, a timeout, a dependency briefly unreachable) becomes claimable
# again. Doubles per attempt, capped below. Without a delay the worker would
# reclaim a just-failed job on its next poll and spend the whole attempt
# budget within seconds of a blip. Default 30.
RETRY_BACKOFF_SECONDS=30

# Optional. Upper bound on the doubled backoff. Default 600.
RETRY_BACKOFF_CAP_SECONDS=600

# ---------------------------------------------------------------------------
# Health probes and AWS client timeouts (Phase 6)
# ---------------------------------------------------------------------------
#
# Optional. Per-dependency budget for GET /health/ready. Short and finite on
# purpose: a readiness check that can hang is worse than one that reports a
# dependency as down. Default 3.
READINESS_TIMEOUT_SECONDS=3

# Optional. Finite timeouts for every boto3 client the application builds.
# These are what make a worker lease meaningful: a call that could hang
# forever would keep a dead-in-the-water worker looking alive, so its job
# would never be recovered. Defaults 10 and 60 seconds.
AWS_CONNECT_TIMEOUT_SECONDS=10
AWS_READ_TIMEOUT_SECONDS=60

# Optional. botocore's attempt budget for ONE API call. Note this MULTIPLIES
# with the application's own retries: AWS_MAX_ATTEMPTS x BEDROCK_MAX_ATTEMPTS
# is the worst case per frame, and each attempt is billed. Raise one, not
# both. Default 3.
AWS_MAX_ATTEMPTS=3

# Optional. Lifetime in minutes of the video playback token carried in the
# ?access_token query parameter. Default 15. Keep it short: because it travels
# in a URL it can reach browser history, Referer headers, and proxy/CDN logs
# that this application cannot redact.
MEDIA_TOKEN_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# MongoDB (user accounts and video ownership records)
# ---------------------------------------------------------------------------

#
# MongoDB holds user accounts (novaflow.users) and video ownership plus job
# state (novaflow.videos). It does NOT hold video or frame bytes - those are
# in S3, with frame metadata in DynamoDB.
#
# MONGO_URI was a second name for MONGODB_URL, read only by the orphaned
# MongoDB/GridFS pipeline. That pipeline was removed in Phase 5, so the
# duplicate is gone: MONGODB_URL is the only connection-string variable.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=novaflow

# ---------------------------------------------------------------------------
# Test-only (never set these in a deployed environment)
# ---------------------------------------------------------------------------
#
# Opt in to the optional real-MongoDB integration tests. The database name
# MUST contain "test": setup DROPS the users and videos collections, and the
# guard refuses anything it cannot positively identify as disposable.
#     pytest -m requires_mongodb
# MONGODB_TEST_URL=mongodb://localhost:27017/novaflow_test
#
# Only needed to target a non-loopback test database you know is disposable.
# MONGODB_TEST_ALLOW_REMOTE=false

# ---------------------------------------------------------------------------
# AWS (S3 source videos and frames, DynamoDB metadata, Bedrock inference)
# ---------------------------------------------------------------------------
#
# Credentials themselves are NOT read from these variables. The backend uses
# the standard boto3 credential chain (IAM role, shared config, or the
# conventional AWS_* variables). Do not add access keys to this file; prefer an
# IAM role or `aws configure`.
#
# Every name below is resolved in exactly one place,
# backend/aws_resources.py, and provisioned by
# infra/cloudformation/storage.yaml.

AWS_REGION=us-east-1

# REQUIRED when NOVAFLOW_ENV=production. The application refuses to start
# without it rather than falling back to the placeholder below, because S3
# bucket names are globally unique: "novaflow-media" is not a bucket you own,
# so accepting it in production would mean every upload failing at the first
# S3 call with an opaque error instead of a clear one at startup. There is no
# local-disk fallback for new uploads in any environment.
#
# Validated at startup against the S3 naming rules, so a typo is reported
# immediately. Set it to the MediaBucketNameOut output of
# infra/cloudformation/storage.yaml.
#
# One bucket, three server-generated prefixes:
#   sources/{video_id}/source.{ext}       uploaded source video
#   frames/{video_id}/frame_NNNN.jpg      extracted frames
#   raw/{project_id}/{agent}/reel.mp4     agent reel uploads
S3_BUCKET_NAME=novaflow-media

# Frame metadata and detections. PK video_id (S), SK frame_number (N).
DYNAMODB_TABLE_NAME=NovaFlowFrames

# Projects and submissions. PK project_id (S), SK sk (S). Previously
# hardcoded; overridable since Phase 4.1 so staging need not share the
# production table.
DYNAMODB_PROJECTS_TABLE=NovaFlowProjects

# Public base URL of the backend, used to build playback URLs.
API_URL=http://localhost:8000

# Optional. Only needed if the Bedrock Guardrails integration is wired up.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
#
# NEXT_PUBLIC_* values are embedded into the browser bundle and are therefore
# PUBLIC. Never put a secret in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional, Phase 7. The upload limits the BROWSER enforces before a byte is
# transferred, and the text shown next to the file picker. The browser cannot
# read the server's configuration, so these only mirror MAX_UPLOAD_BYTES and
# ALLOWED_VIDEO_EXTENSIONS above; the backend validates every upload
# independently and its rejection message is what the user sees when the two
# disagree.
#
# SET THESE WHENEVER YOU NARROW THE SERVER-SIDE LIMITS. Leaving them at the
# defaults while the server accepts less means the UI advertises a limit the
# server will refuse - the exact kind of untrue interface Phase 7 removed.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=104857600
NEXT_PUBLIC_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,webm,mkv
