# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# data (anchored to repo root: unanchored 'data/' also excluded source
# directories such as frontend_backup/.../src/app/data/ — Phase 0 fix)
/mongodb/
/data/
*.db
*.sqlite3

# ---------------------------------------------------------------------------
# NovaFlow project additions (Phase 0 — repository recovery)
# Rationale: see docs/PROJECT_AUDIT.md §10.6
# ---------------------------------------------------------------------------

# runtime artifacts produced by the video pipeline
backend/uploads/
temp_frames_*/
test_output.jpg
final_compliant_video.mp4

# local agent/editor configuration (developer-local, must not be shared)
.claude/settings.local.json
.vscode/
.idea/

# OS / editor noise
Thumbs.db
desktop.ini
*.swp
*~

# secrets & local cloud configuration (belt-and-braces alongside .env* above)
*.key
*.pem
.aws/
credentials
